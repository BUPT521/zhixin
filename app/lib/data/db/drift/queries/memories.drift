-- 记忆的读写查询：一张表一个文件。

import '../tables.dart';

-- 全部记忆；只看有效条目时传 1。
listMemories:
SELECT * FROM memory
WHERE (:activeOnly = 0 OR status = 'active')
ORDER BY status, updated_at DESC, id DESC;

-- 同一范围里仍然有效的困难记忆；范围用空串表示无归属。
activeDifficulties(REQUIRED :scope AS TEXT):
SELECT id, content FROM memory
WHERE status = 'active' AND kind = :kind
  AND ((:scope = '' AND scope IS NULL) OR (:scope <> '' AND scope = :scope))
ORDER BY id DESC;

-- 按编号取一条。
memoryById:
SELECT * FROM memory WHERE id = :id;

-- 当前有效记忆的类型、范围与正文，用于去重判断。
activeMemoryIdentities:
SELECT kind, scope, content FROM memory
WHERE status = 'active'
  AND (valid_until IS NULL OR valid_until >= :now);

-- 生成回答时取用的记忆：本次范围的排在前面，再按类型与更新时间。
-- :scope 显式声明为必填文本：它同时与 '' 和可空的 scope 列比较，靠推断会在
-- 可空与非空之间摇摆，生成文件因此每次重建都可能不同。
memoriesForContext(REQUIRED :scope AS TEXT, REQUIRED :rowLimit AS INT OR NULL):
SELECT * FROM memory
WHERE status = 'active'
  AND (valid_until IS NULL OR valid_until >= :now)
  AND (
    (:scope = '' AND scope IS NULL)
    OR (:scope <> '' AND (scope IS NULL OR scope = :scope))
  )
ORDER BY
  CASE WHEN scope IS NULL THEN 1 ELSE 0 END,
  CASE kind WHEN 'constraint' THEN 0 WHEN 'preference' THEN 1
    WHEN 'difficulty' THEN 2 ELSE 3 END,
  updated_at DESC, id DESC
LIMIT COALESCE(:rowLimit, -1);

-- 某条来源是否已经写进记忆。
hasMemoryFromSource:
SELECT id FROM memory
WHERE source_kind = :sourceKind AND source_id = :sourceId
LIMIT 1;

insertMemory:
INSERT INTO memory (id, kind, content, scope, source_kind, source_id, valid_until, status, created_at, updated_at)
VALUES (:id, :kind, :content, :scope, :sourceKind, :sourceId, :validUntil, 'active', :stamp, :stamp);

updateMemoryContent:
UPDATE memory SET content = :content,
  valid_until = :validUntil,
  kind = :kind,
  scope = :scope,
  updated_at = :stamp
WHERE id = :memoryId;

setMemoryStatus:
UPDATE memory SET status = :status,
  updated_at = :stamp
WHERE id = :memoryId;
