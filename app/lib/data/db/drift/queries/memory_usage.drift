-- 记忆使用统计：召回先记在本机缓冲表，冲刷时汇总进统计（ADR-0051 决定第 8 条，
-- 审查 S16）。

import '../tables.dart';

-- 本机缓冲里还没有汇总的召回与读出，按记忆与种类聚合；冲刷按它累加计数。
localUseCounts:
SELECT memory_id AS memory_id, kind AS kind, COUNT(*) AS use_count,
  MAX(used_at) AS last_used_at
FROM local_memory_use
GROUP BY memory_id, kind;

-- 记一次召回或读出。这是本机缓冲，写入不形成提交，也不再需要按编号去重：
-- 缓冲表按行号自增，同一秒的连续使用各记一行。
insertLocalMemoryUse(
  REQUIRED :memoryId AS TEXT,
  REQUIRED :kind AS TEXT,
  REQUIRED :usedAt AS TEXT
):
INSERT INTO local_memory_use (memory_id, kind, used_at)
VALUES (:memoryId, :kind, :usedAt);

-- 一次冲刷之后清空缓冲：汇总与删除在同一个事务里，所以不需要水位。
deleteLocalMemoryUses:
DELETE FROM local_memory_use;

-- 某台设备用过哪些记忆，用于整理时判断“很久没用到”；缓冲里还没汇总的也算。
usedMemoryIds(REQUIRED :deviceId AS TEXT):
SELECT memory_id FROM memory_usage WHERE device_id = :deviceId
UNION
SELECT memory_id FROM local_memory_use;

-- 记忆编号加设备编号定位的一行统计；没有这一行时冲刷新建。
usageOf(REQUIRED :memoryId AS TEXT, REQUIRED :deviceId AS TEXT):
SELECT * FROM memory_usage
WHERE memory_id = :memoryId AND device_id = :deviceId
LIMIT 1;

-- 按设备汇总的计数，整理页读这一份。
usageForDevice(REQUIRED :deviceId AS TEXT):
SELECT * FROM memory_usage WHERE device_id = :deviceId;

insertMemoryUsage:
INSERT INTO memory_usage (id, memory_id, device_id, recall_count, search_count, last_recalled_at, last_searched_at, updated_at)
VALUES (:id, :memoryId, :deviceId, :recallCount, :searchCount, :lastRecalledAt, :lastSearchedAt, :updatedAt);

updateMemoryUsage:
UPDATE memory_usage SET
  recall_count = :recallCount,
  search_count = :searchCount,
  last_recalled_at = :lastRecalledAt,
  last_searched_at = :lastSearchedAt,
  updated_at = :updatedAt
WHERE id = :id;
