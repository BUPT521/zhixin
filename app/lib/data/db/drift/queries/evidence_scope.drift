-- 检索命中后的范围核对（ADR-0011 第二批）。
--
-- 取整行而不是只取归属列：goal_id 与 material_id 本身可空，
-- “没有这条记录”与“记录不属于任何目标或材料”要分开处理。

import '../tables.dart';

conversationScope:
SELECT id, goal_id, material_id FROM conversation WHERE id = :id LIMIT 1;

materialScope:
SELECT id, goal_id FROM material WHERE id = :id LIMIT 1;
