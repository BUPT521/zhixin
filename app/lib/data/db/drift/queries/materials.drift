-- 材料的读写查询：一张表一个文件。

import '../tables.dart';

materialScope:
SELECT id, goal_id FROM material WHERE id = :id LIMIT 1;

-- 材料原文件的哈希，用于取回附件字节。
materialFileHash:
SELECT source_file_hash FROM material WHERE id = :materialId LIMIT 1;

-- 单份材料，带页数。
materialById:
SELECT m.*,
  (SELECT COUNT(*) FROM material_page p WHERE p.material_id = m.id) AS page_count
FROM material m
WHERE m.id = :id;

-- 材料列表；`goalId` 传空表示不限目标，非空时取该目标与没有归属的材料。
materialList(REQUIRED :goalId AS INT OR NULL):
SELECT m.*,
  (SELECT COUNT(*) FROM material_page p WHERE p.material_id = m.id) AS page_count
FROM material m
WHERE (:goalId IS NULL OR m.goal_id = :goalId OR m.goal_id IS NULL)
ORDER BY m.updated_at DESC, m.id DESC;

insertMaterial:
INSERT INTO material (title, kind, source_ref, source_file_name, source_file_hash, goal_id, created_at, updated_at)
VALUES (:title, :kind, :sourceRef, :fileName, :fileHash, :goalId, :stamp, :stamp);

setMaterialGoal:
UPDATE material SET goal_id = :goalId,
  updated_at = :stamp
WHERE id = :materialId;

touchMaterial:
UPDATE material SET updated_at = :stamp
WHERE id = :materialId;
