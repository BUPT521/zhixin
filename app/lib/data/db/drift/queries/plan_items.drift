-- 事项与计划步骤的读写查询：一张表一个文件。

import '../tables.dart';

-- 从讨论里接受建议后按标题找回刚建立的事项，供重复请求返回原结果。
itemByConversationAndTitle:
SELECT p.*,
  (SELECT m.source_file_name FROM study_plan sp
    JOIN material m ON m.id = sp.material_id
    WHERE sp.id = p.study_plan_id) AS source_file_name
FROM plan_item p
WHERE p.conversation_id = :conversationId AND p.title = :title
ORDER BY p.id DESC
LIMIT 1;

-- 某个事项所属的计划编号。取整行而不是只取 study_plan_id：
-- 这一列本身可空，“没有这个事项”与“事项不属于任何计划”是两回事。
itemPlan:
SELECT id, study_plan_id FROM plan_item WHERE id = :itemId LIMIT 1;

-- 一份计划下的全部步骤，按次序。
stepsOfPlan:
SELECT * FROM plan_item
WHERE study_plan_id = :planId
ORDER BY seq, id;

insertStudyPlanStep:
INSERT INTO plan_item (id, goal_id, conversation_id, study_plan_id, seq, title, note, page_from, page_to, priority, status, source, created_at, updated_at)
VALUES (:id, :goalId, NULL, :planId, :seq, :title, :note, :pageFrom, :pageTo, 0, :status, 'user', :stamp, :stamp);

setStudyStepConversation:
UPDATE plan_item SET conversation_id = :conversationId
WHERE id = :stepId AND study_plan_id = :planId;

setStudyStepStatus:
UPDATE plan_item SET status = :status,
  completed_at = :completedAt,
  updated_at = :stamp
WHERE id = :itemId;

resetOtherActiveStudySteps:
UPDATE plan_item SET status = :todoStatus,
  updated_at = :stamp
WHERE study_plan_id = :planId AND id != :itemId AND status = :doingStatus;

-- 一份计划的步骤，按顺序。
planSteps:
SELECT p.*,
  (SELECT m.source_file_name FROM study_plan sp
    JOIN material m ON m.id = sp.material_id
    WHERE sp.id = p.study_plan_id) AS source_file_name
FROM plan_item p
WHERE p.study_plan_id = :planId
ORDER BY p.seq, p.id;

-- 多份计划的步骤，按计划与顺序。
planStepsForPlans:
SELECT p.*,
  (SELECT m.source_file_name FROM study_plan sp
    JOIN material m ON m.id = sp.material_id
    WHERE sp.id = p.study_plan_id) AS source_file_name
FROM plan_item p
WHERE p.study_plan_id IN (SELECT value FROM json_each(:planIds))
ORDER BY p.study_plan_id, p.seq, p.id;

-- 完成一步时按是否真的学过回写预约状态：与场次有重叠的记为完成，
-- 到过开始时间却没有场次的按取消处理。
settleBlocksOnStepDone:
UPDATE schedule_block SET status = CASE WHEN EXISTS (
  SELECT 1 FROM study_session s
  WHERE s.plan_item_id = schedule_block.plan_item_id
    AND s.started_at < schedule_block.end_at
    AND COALESCE(s.ended_at, :now) > schedule_block.start_at
) THEN :doneStatus ELSE :cancelledStatus END,
  updated_at = :now
WHERE plan_item_id = :itemId AND status = :plannedStatus;

-- 事项列表：进行中的排在前面，再按截止时间排。
--
-- 不带材料来源文件名，是因为事项列表页不显示它；需要的地方用下面的
-- 单条查询与批量查询。
items:
SELECT p.*,
  (SELECT m.source_file_name FROM study_plan sp
    JOIN material m ON m.id = sp.material_id
    WHERE sp.id = p.study_plan_id) AS source_file_name
FROM plan_item p
LEFT JOIN learning_goal g ON g.id = p.goal_id
WHERE (:openOnly = 0 OR p.status IN (:todoStatus, :doingStatus))
  AND (:onlyActiveGoals = 0 OR p.goal_id IS NULL OR g.status = :activeStatus)
ORDER BY
  CASE WHEN :statusFirst = 0 THEN 0
    WHEN p.status = :doingStatus THEN 0
    WHEN p.status = :todoStatus THEN 1
    WHEN p.status = :deferredStatus THEN 2
    WHEN p.status = :doneStatus THEN 3
    ELSE 4 END,
  p.due_at IS NULL, p.due_at, p.id DESC;

-- 单条事项，带材料来源文件名。
itemById:
SELECT p.*,
  (SELECT m.source_file_name FROM study_plan sp
    JOIN material m ON m.id = sp.material_id
    WHERE sp.id = p.study_plan_id) AS source_file_name
FROM plan_item p
WHERE p.id = :id;

-- 这条讨论绑定的事项；同一条讨论可能留下多条，取最新一条。
itemByConversation:
SELECT p.*,
  (SELECT m.source_file_name FROM study_plan sp
    JOIN material m ON m.id = sp.material_id
    WHERE sp.id = p.study_plan_id) AS source_file_name
FROM plan_item p
WHERE p.conversation_id = :conversationId
ORDER BY p.id DESC
LIMIT 1;

-- 这条讨论里同一个建议编号对应的事项；重复请求据此返回原结果。
itemByConversationAndStep:
SELECT p.*,
  (SELECT m.source_file_name FROM study_plan sp
    JOIN material m ON m.id = sp.material_id
    WHERE sp.id = p.study_plan_id) AS source_file_name
FROM plan_item p
WHERE p.conversation_id = :conversationId
  AND json_extract(p.origin_json, '$.step_id') = :stepId
ORDER BY p.id DESC
LIMIT 1;

-- 已完成事项，按最近完成时间从新到旧逐页读。
doneItems:
SELECT p.*,
  (SELECT m.source_file_name FROM study_plan sp
    JOIN material m ON m.id = sp.material_id
    WHERE sp.id = p.study_plan_id) AS source_file_name
FROM plan_item p
WHERE p.status = :doneStatus
ORDER BY p.completed_at DESC, p.id DESC
LIMIT :rowLimit OFFSET :rowOffset;

-- 已完成事项总数。
countDoneItems:
SELECT COUNT(*) AS n FROM plan_item WHERE status = :doneStatus;

-- 按编号批量取事项。
itemsByIds:
SELECT p.*,
  (SELECT m.source_file_name FROM study_plan sp
    JOIN material m ON m.id = sp.material_id
    WHERE sp.id = p.study_plan_id) AS source_file_name
FROM plan_item p
WHERE p.id IN (SELECT value FROM json_each(:itemIds));

-- 安排查找的事项：目标、状态与截止日期在库里筛，关键词由应用层筛。
--
-- 三个条件都传空串表示不限；日期条件是自然日区间 [dayStart, dayEnd)，
-- 截止时间为空的事项不进入带日期的结果。关键词的切词与大小写规则在应用层
-- 只留一份，不写进 SQL（docs/02 第 3.14 节）。
searchPlanItems:
SELECT p.*,
  (SELECT m.source_file_name FROM study_plan sp
    JOIN material m ON m.id = sp.material_id
    WHERE sp.id = p.study_plan_id) AS source_file_name
FROM plan_item p
WHERE (:goalId = '' OR p.goal_id = :goalId)
  AND (:status = '' OR p.status = :status)
  AND (:dayStart = '' OR
    (p.due_at IS NOT NULL AND p.due_at >= :dayStart AND p.due_at < :dayEnd))
ORDER BY p.due_at IS NULL, p.due_at DESC, p.id DESC;

-- 待办里截止最近的一条；所属目标已暂停的事项不参与推荐。
nextDueItem:
SELECT p.*,
  (SELECT m.source_file_name FROM study_plan sp
    JOIN material m ON m.id = sp.material_id
    WHERE sp.id = p.study_plan_id) AS source_file_name
FROM plan_item p
LEFT JOIN learning_goal g ON g.id = p.goal_id
WHERE p.status IN (:todoStatus, :doingStatus)
  AND (p.goal_id IS NULL OR g.status = :activeStatus)
ORDER BY p.due_at IS NULL, p.due_at, p.id
LIMIT 1;

bindTaskConversation:
UPDATE plan_item SET conversation_id = :conversationId,
  updated_at = :stamp
WHERE id = :itemId AND conversation_id IS NULL;

insertPlanItem:
INSERT INTO plan_item (id, goal_id, conversation_id, title, note, due_at, est_minutes, status, source, origin_json, created_at, updated_at)
VALUES (:id, :goalId, :conversationId, :title, :note, :dueAt, :estMinutes, :status, :source, :origin, :stamp, :stamp);

setPlanItemPriority:
UPDATE plan_item SET priority = :priority,
  updated_at = :stamp
WHERE id = :itemId;
