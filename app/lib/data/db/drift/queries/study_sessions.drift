-- 学习场次的读写查询：一张表一个文件。

import '../tables.dart';

-- 当前打开的场次：先按讨论找；没有讨论时按事项找；都没有时按目标找。
-- 编号传 0 表示这一层不适用，与原来的嵌套判断一致。
openStudySession:
SELECT * FROM study_session
WHERE ended_at IS NULL
  AND (
    (:conversationId <> 0 AND conversation_id = :conversationId)
    OR (
      :conversationId = 0 AND conversation_id IS NULL
      AND (
        (:planItemId <> 0 AND plan_item_id = :planItemId)
        OR (
          :planItemId = 0 AND plan_item_id IS NULL
          AND (
            (:goalId = 0 AND goal_id IS NULL)
            OR (:goalId <> 0 AND goal_id = :goalId)
          )
        )
      )
    )
  )
ORDER BY id DESC
LIMIT 1;

-- 按编号取一场。
studySessionById:
SELECT * FROM study_session WHERE id = :id;

-- 最近的几场，按编号倒序。
recentStudySessions:
SELECT * FROM study_session ORDER BY id DESC LIMIT :rowLimit;

-- 同一目标下已经结束的场次，按结束时间倒序；`rowLimit` 传空表示不截断。
endedStudySessionsForGoal(REQUIRED :rowLimit AS INT OR NULL):
SELECT * FROM study_session
WHERE goal_id = :goalId AND ended_at IS NOT NULL
ORDER BY ended_at DESC, id DESC
LIMIT COALESCE(:rowLimit, -1);

-- 多个学习步骤已结束的场次，按结束时间升序；调用方取每个步骤最后一条。
endedStudySessionsForPlanItems:
SELECT * FROM study_session
WHERE plan_item_id IN (SELECT value FROM json_each(:planItemIds))
  AND ended_at IS NOT NULL
ORDER BY ended_at ASC, id ASC;

insertStudySession:
INSERT INTO study_session (goal_id, plan_item_id, conversation_id, started_at, created_at, updated_at)
VALUES (:goalId, :itemId, :conversationId, :stamp, :stamp, :stamp);

finishStudySession:
UPDATE study_session SET outcome = :outcome,
  summary = :summary,
  ended_at = :stamp,
  updated_at = :stamp
WHERE id = :sessionId;

deleteStudySession:
DELETE FROM study_session WHERE id = :sessionId;
