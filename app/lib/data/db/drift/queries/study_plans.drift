-- 系统学习计划的读写查询：一张表一个文件。

import '../tables.dart';

-- 按编号取一份计划。
studyPlanById:
SELECT * FROM study_plan WHERE id = :id LIMIT 1;

-- 计划列表；参数按调用点传，不生效的条件由空参数关掉。
planRows(
  REQUIRED :doneStatus AS TEXT,
  REQUIRED :id AS TEXT OR NULL,
  REQUIRED :openOnly AS INT,
  REQUIRED :activeStatus AS TEXT,
  REQUIRED :pausedStatus AS TEXT,
  REQUIRED :activeOnly AS INT,
  REQUIRED :statusFirst AS INT,
  REQUIRED :rowLimit AS INT OR NULL
):
SELECT sp.*,
  (SELECT title FROM material WHERE id = sp.material_id) AS material_title,
  (SELECT source_file_name FROM material WHERE id = sp.material_id)
    AS source_file_name,
  (SELECT COUNT(*) FROM plan_item pi
    WHERE pi.study_plan_id = sp.id AND pi.status = :doneStatus) AS steps_done,
  (SELECT COUNT(*) FROM plan_item pi WHERE pi.study_plan_id = sp.id)
    AS steps_total,
  (SELECT pi.title FROM plan_item pi WHERE pi.study_plan_id = sp.id
    AND pi.status IN ('doing', 'todo')
    ORDER BY CASE pi.status WHEN 'doing' THEN 0 ELSE 1 END, pi.seq, pi.id
    LIMIT 1) AS next_step_title
FROM study_plan sp
WHERE (:id IS NULL OR sp.id = :id)
  AND (:openOnly = 0 OR sp.status IN (:activeStatus, :pausedStatus))
  AND (:activeOnly = 0 OR sp.status = :activeStatus)
ORDER BY
  CASE WHEN :statusFirst = 0 THEN 0
    WHEN sp.status = :activeStatus THEN 0
    WHEN sp.status = :pausedStatus THEN 1
    ELSE 2 END,
  sp.updated_at DESC, sp.id DESC
LIMIT COALESCE(:rowLimit, -1);

insertStudyPlan:
INSERT INTO study_plan (id, material_id, goal_id, conversation_id, title, page_from, page_to, current_page, status, created_at, updated_at)
VALUES (:id, :materialId, :goalId, :conversationId, :title, :pageFrom, :pageTo, :currentPage, :status, :stamp, :stamp);

setStudyPlanStatus:
UPDATE study_plan SET status = :status,
  updated_at = :stamp
WHERE id = :planId;

updateStudyPlanProgress(REQUIRED :status AS TEXT OR NULL):
UPDATE study_plan SET current_page = :currentPage,
  status = COALESCE(:status, status),
  updated_at = :stamp
WHERE id = :planId;
