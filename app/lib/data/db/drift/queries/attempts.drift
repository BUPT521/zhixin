-- 作答与草稿的读写查询：一张表一个文件。

import '../tables.dart';

-- 这次作答的提交时间；没有这一行表示作答不存在，提交时间为空表示还没提交。
-- 取整行而不是只取 submitted_at，否则「有草稿未提交」与「没有这一行」区分不开。
attemptSubmission:
SELECT id, submitted_at FROM attempt WHERE id = :attemptId LIMIT 1;

-- 一条学习记录的全部作答，按编号倒序。
attemptsForConversation:
SELECT * FROM attempt
WHERE conversation_id = :conversationId
ORDER BY id DESC;

-- 同一道题以前写下的困难：已提交且有非空反馈，最多取若干条。
priorFeedback:
SELECT * FROM attempt
WHERE conversation_id = :conversationId
  AND submitted_at IS NOT NULL
  AND feedback IS NOT NULL AND TRIM(feedback) <> ''
ORDER BY submitted_at DESC, id DESC
LIMIT :rowLimit;

-- 最近一次已提交的作答。
latestSubmittedAttempt:
SELECT * FROM attempt
WHERE conversation_id = :conversationId AND submitted_at IS NOT NULL
ORDER BY submitted_at DESC, id DESC
LIMIT 1;

-- 按编号取一条作答。
attemptById:
SELECT * FROM attempt WHERE id = :id LIMIT 1;

-- 这条记录里未提交的尝试，没有就建一条时用来查已有草稿。
openAttempt:
SELECT * FROM attempt
WHERE conversation_id = :conversationId AND submitted_at IS NULL
ORDER BY id DESC
LIMIT 1;

-- 这条讨论最近一次作答所属场次的目标；目标为空表示没有归属。
sessionGoalOfConversation:
SELECT s.goal_id FROM attempt a
JOIN study_session s ON s.id = a.session_id
WHERE a.conversation_id = :conversationId AND s.goal_id IS NOT NULL
ORDER BY a.id DESC
LIMIT 1;

-- 这次讨论还没提交的草稿存在时不再新建，避免连点建立两份。
insertOpenAttempt:
INSERT INTO attempt
  (id, conversation_id, session_id, redo_of_attempt_id, delayed, created_at,
   updated_at)
SELECT :id, :conversationId, :sessionId, :redoOfAttemptId, :delayed, :createdAt,
  :updatedAt
WHERE NOT EXISTS (
  SELECT 1 FROM attempt
  WHERE conversation_id = :conversationId AND submitted_at IS NULL
);

updateOpenAttemptContext(
  REQUIRED :sessionId AS TEXT OR NULL,
  REQUIRED :redoOfAttemptId AS TEXT OR NULL,
  REQUIRED :delayed AS BOOL OR NULL
):
UPDATE attempt SET session_id = COALESCE(:sessionId, session_id),
  redo_of_attempt_id = COALESCE(:redoOfAttemptId, redo_of_attempt_id),
  delayed = COALESCE(:delayed, delayed),
  updated_at = :stamp
WHERE id = :attemptId AND submitted_at IS NULL;

saveOpenAttemptDraft:
UPDATE attempt SET user_answer = :answer,
  solution = :solution,
  is_correct = :isCorrect,
  independent = :independent,
  delayed = :delayed,
  feedback = :feedback,
  updated_at = :stamp
WHERE id = :attemptId AND submitted_at IS NULL;

setAttemptHelp:
UPDATE attempt SET help_json = :helpJson,
  updated_at = :stamp
WHERE id = :attemptId;

submitOpenAttempt:
UPDATE attempt SET user_answer = :answer,
  solution = :solution,
  is_correct = :isCorrect,
  independent = :independent,
  delayed = :delayed,
  feedback = :feedback,
  submitted_at = :stamp,
  updated_at = :stamp
WHERE id = :attemptId AND submitted_at IS NULL;

-- 这条记录里出现过的场次编号，清空记录时逐个核对是否还被别的记录引用。
sessionIdsOfConversation:
SELECT DISTINCT session_id FROM attempt
WHERE conversation_id = :conversationId AND session_id IS NOT NULL;

-- 这个场次里还剩下几条作答，清空记录时决定要不要一起删场次。
attemptsInSession:
SELECT id FROM attempt WHERE session_id = :sessionId LIMIT 1;

-- 最近提交的作答，带上所属记录；目标、材料与讨论三个条件传空表示不限。
recentSubmitted(
  REQUIRED :goalId AS TEXT OR NULL,
  REQUIRED :materialId AS TEXT OR NULL,
  REQUIRED :conversationId AS TEXT OR NULL,
  REQUIRED :broughtIds AS TEXT,
  REQUIRED :rowLimit AS INT OR NULL
):
SELECT
  a.id AS attempt_id,
  a.conversation_id AS attempt_conversation_id,
  a.session_id AS attempt_session_id,
  a.user_answer AS attempt_user_answer,
  a.solution AS attempt_solution,
  a.is_correct AS attempt_is_correct,
  a.independent AS attempt_independent,
  a.help_json AS attempt_help_json,
  a.feedback AS attempt_feedback,
  a.delayed AS attempt_delayed,
  a.submitted_at AS attempt_submitted_at,
  a.created_at AS attempt_created_at,
  c.id AS question_id,
  c.source_ref AS question_source_ref,
  c.context_text AS question_context_text,
  c.page_no AS question_page_no,
  c.created_at AS question_created_at,
  c.updated_at AS question_updated_at,
  (SELECT title FROM material WHERE id = c.material_id)
    AS question_material_title,
  (SELECT source_file_name FROM material WHERE id = c.material_id)
    AS source_file_name,
  (SELECT m.content FROM message m WHERE m.conversation_id = c.id
    AND m.role = 'user' AND m.id = (
      COALESCE(c.question_message_id, (SELECT m2.id FROM message m2
        WHERE m2.conversation_id = c.id AND m2.role = 'user'
        ORDER BY m2.id LIMIT 1))
    ) LIMIT 1) AS question_stem,
  (SELECT m.image_paths_json FROM message m WHERE m.conversation_id = c.id
    AND m.role = 'user' AND m.id = (
      COALESCE(c.question_message_id, (SELECT m2.id FROM message m2
        WHERE m2.conversation_id = c.id AND m2.role = 'user'
        ORDER BY m2.id LIMIT 1))
    ) LIMIT 1) AS question_image_paths_json
FROM attempt a
JOIN conversation c ON c.id = a.conversation_id
WHERE a.submitted_at IS NOT NULL
  AND (
    (:goalId IS NOT NULL AND c.goal_id = :goalId)
    OR (:materialId IS NOT NULL AND c.material_id = :materialId)
    OR (
      c.goal_id IS NULL AND c.material_id IS NULL
      AND (
        :goalId IS NOT NULL
        OR :materialId IS NOT NULL
        OR (:conversationId IS NOT NULL AND c.id = :conversationId)
        OR a.id IN (SELECT value FROM json_each(:broughtIds))
      )
    )
    OR (
      (:goalId IS NOT NULL OR :materialId IS NOT NULL)
      AND a.id IN (SELECT value FROM json_each(:broughtIds))
    )
  )
ORDER BY a.submitted_at DESC, a.id DESC
LIMIT COALESCE(:rowLimit, -1);

-- 检索核对：一次已提交作答命中的当前内容与所属讨论。
evidenceAnswerCurrent:
SELECT a.id, a.conversation_id, a.user_answer, a.solution, a.feedback,
  a.submitted_at, c.title, c.source_ref
FROM attempt a
JOIN conversation c ON c.id = a.conversation_id
WHERE a.id = :attemptId AND a.submitted_at IS NOT NULL
LIMIT 1;

-- 语义索引可用的全部已提交作答：按提交时间倒序，后台分批重建索引。
evidenceAnswerSources:
SELECT a.id, a.conversation_id, a.user_answer, a.solution, a.feedback,
  a.submitted_at, c.material_id
FROM attempt a
JOIN conversation c ON c.id = a.conversation_id
WHERE a.submitted_at IS NOT NULL
ORDER BY a.submitted_at DESC, a.id DESC;

-- 一次已提交作答的当前内容与更新时间；嵌入很慢，写回索引前要重新读一次。
evidenceAnswerSource:
SELECT user_answer, solution, feedback, submitted_at
FROM attempt
WHERE id = :attemptId AND submitted_at IS NOT NULL
LIMIT 1;

-- 沿同一道题、同一份材料页或用户选定的目标找最近的已提交作答。
--
-- 四条线索都传空表示不限；`from`、`to` 是显式时间条件。先按提交时间倒序取
-- 最近的若干次，调用方再反转成时间正序，截断因此发生在时间正序之前，“上次”
-- 是本轮之前最近的一次，不会退回到最早几次。
--
-- `includeUnassigned` 传 1 表示同时放行没有目标归属的记录，只在给了目标时
-- 有意义；传 0 表示只取同目标的记录，与 `conversation_records` 的筛选开关
-- 同一写法。
evidenceThreadAttempts(
  REQUIRED :conversationId AS TEXT OR NULL,
  REQUIRED :stem AS TEXT OR NULL,
  REQUIRED :materialId AS TEXT OR NULL,
  REQUIRED :pageNo AS INT OR NULL,
  REQUIRED :goalId AS TEXT OR NULL,
  REQUIRED :includeUnassigned AS INT,
  REQUIRED :from AS TEXT OR NULL,
  REQUIRED :to AS TEXT OR NULL,
  REQUIRED :rowLimit AS INT
):
SELECT a.*,
  c.source_ref AS thread_source_ref,
  c.material_id AS thread_material_id,
  c.page_no AS thread_page_no,
  c.goal_id AS thread_goal_id,
  COALESCE((SELECT m.content FROM message m
    WHERE m.conversation_id = c.id AND m.role = 'user'
      AND m.id = COALESCE(c.question_message_id, (
        SELECT m2.id FROM message m2
        WHERE m2.conversation_id = c.id AND m2.role = 'user'
        ORDER BY m2.id LIMIT 1
      )) LIMIT 1), '') AS thread_stem
FROM attempt a
JOIN conversation c ON c.id = a.conversation_id
WHERE a.submitted_at IS NOT NULL
  AND (:conversationId IS NULL OR c.id = :conversationId)
  AND (:stem IS NULL OR (SELECT m.content FROM message m
    WHERE m.conversation_id = c.id AND m.role = 'user'
      AND m.id = COALESCE(c.question_message_id, (
        SELECT m2.id FROM message m2
        WHERE m2.conversation_id = c.id AND m2.role = 'user'
        ORDER BY m2.id LIMIT 1
      )) LIMIT 1) = :stem)
  AND (:materialId IS NULL OR (c.material_id = :materialId
    AND (:pageNo IS NULL OR c.page_no = :pageNo)))
  AND (:goalId IS NULL OR c.goal_id = :goalId
    OR (:includeUnassigned = 1 AND c.goal_id IS NULL))
  AND (:from IS NULL OR a.submitted_at >= :from)
  AND (:to IS NULL OR a.submitted_at < :to)
ORDER BY a.submitted_at DESC, a.id DESC
LIMIT :rowLimit;
