-- 讨论与题目的读写查询：一张表一个文件。

import '../tables.dart';

-- 一条记录，带材料标题与是否有作答、是否有草稿。
conversationById:
SELECT c.*,
  (SELECT title FROM material WHERE id = c.material_id) AS material_title,
  (SELECT source_file_name FROM material WHERE id = c.material_id)
    AS source_file_name,
  EXISTS (SELECT 1 FROM attempt a WHERE a.conversation_id = c.id)
    AS has_attempts,
  EXISTS (SELECT 1 FROM attempt a WHERE a.conversation_id = c.id
    AND a.submitted_at IS NULL) AS has_draft
FROM conversation c
WHERE c.id = :conversationId
LIMIT 1;

-- 一条记录对应的题目视图：题干与图片取开始作答时确定的用户消息。
conversationQuestion:
SELECT c.id, c.source_ref, c.context_text, c.page_no,
  c.created_at, c.updated_at,
  (SELECT title FROM material WHERE id = c.material_id) AS material_title,
  (SELECT source_file_name FROM material WHERE id = c.material_id)
    AS source_file_name,
  (SELECT m.content FROM message m WHERE m.conversation_id = c.id
    AND m.role = 'user' AND m.id = (
      COALESCE(c.question_message_id, (SELECT m2.id FROM message m2
        WHERE m2.conversation_id = c.id AND m2.role = 'user'
        ORDER BY m2.id LIMIT 1))
    ) LIMIT 1) AS stem,
  (SELECT m.image_paths_json FROM message m WHERE m.conversation_id = c.id
    AND m.role = 'user' AND m.id = (
      COALESCE(c.question_message_id, (SELECT m2.id FROM message m2
        WHERE m2.conversation_id = c.id AND m2.role = 'user'
        ORDER BY m2.id LIMIT 1))
    ) LIMIT 1) AS image_paths_json
FROM conversation c
WHERE c.id = :conversationId
LIMIT 1;

-- 有作答记录的学习记录，带最近一次已提交作答；记录页按页读取时用
-- `conversationIds` 限制在当前这一页，传空表示不限制。
questionRows(
  REQUIRED :conversationIds AS TEXT OR NULL,
  REQUIRED :rowLimit AS INT OR NULL
):
SELECT c.id, c.source_ref, c.context_text, c.page_no,
  c.created_at, c.updated_at,
  (SELECT title FROM material WHERE id = c.material_id) AS material_title,
  (SELECT source_file_name FROM material WHERE id = c.material_id)
    AS source_file_name,
  (SELECT m.content FROM message m WHERE m.conversation_id = c.id
    AND m.role = 'user' AND m.id = (
      COALESCE(c.question_message_id, (SELECT m2.id FROM message m2
        WHERE m2.conversation_id = c.id AND m2.role = 'user'
        ORDER BY m2.id LIMIT 1))
    ) LIMIT 1) AS stem,
  (SELECT m.image_paths_json FROM message m WHERE m.conversation_id = c.id
    AND m.role = 'user' AND m.id = (
      COALESCE(c.question_message_id, (SELECT m2.id FROM message m2
        WHERE m2.conversation_id = c.id AND m2.role = 'user'
        ORDER BY m2.id LIMIT 1))
    ) LIMIT 1) AS image_paths_json,
  a.id AS last_attempt_id,
  a.session_id AS last_attempt_session_id,
  a.user_answer AS last_attempt_user_answer,
  a.solution AS last_attempt_solution,
  a.is_correct AS last_attempt_is_correct,
  a.independent AS last_attempt_independent,
  a.help_json AS last_attempt_help_json,
  a.feedback AS last_attempt_feedback,
  a.delayed AS last_attempt_delayed,
  a.submitted_at AS last_attempt_submitted_at,
  a.created_at AS last_attempt_created_at,
  EXISTS (SELECT 1 FROM attempt a3 WHERE a3.conversation_id = c.id
    AND a3.submitted_at IS NULL) AS has_draft
FROM conversation c
LEFT JOIN attempt a ON a.id = (
  SELECT a2.id FROM attempt a2
  WHERE a2.conversation_id = c.id AND a2.submitted_at IS NOT NULL
  ORDER BY a2.submitted_at DESC, a2.id DESC
  LIMIT 1
)
WHERE EXISTS (SELECT 1 FROM attempt a3 WHERE a3.conversation_id = c.id)
  AND (:conversationIds IS NULL
    OR c.id IN (SELECT value FROM json_each(:conversationIds)))
ORDER BY c.updated_at DESC, c.id DESC
LIMIT COALESCE(:rowLimit, -1);

-- 记录列表：按最近更新时间倒序，带消息条数、摘要、最后一条用户消息与草稿。
--
-- 目标、只看无归属与作答状态三种筛选用可空参数关掉，传空表示不筛选；作答状态
-- 的取值按最近一次已提交作答的判定过滤，口径与界面的作答状态一致。
conversationRecords(
  REQUIRED :goalId AS INT OR NULL,
  REQUIRED :unassignedOnly AS INT,
  REQUIRED :answerStatus AS TEXT OR NULL,
  REQUIRED :rowLimit AS INT OR NULL,
  REQUIRED :rowOffset AS INT
):
SELECT c.*,
  (SELECT COUNT(*) FROM message m WHERE m.conversation_id = c.id)
    AS message_count,
  (SELECT m.content FROM message m WHERE m.conversation_id = c.id
    ORDER BY m.id DESC LIMIT 1) AS preview,
  (SELECT m.content FROM message m WHERE m.conversation_id = c.id
    AND m.role = 'user' ORDER BY m.id DESC LIMIT 1) AS last_user_message,
  (SELECT a.user_answer FROM attempt a WHERE a.conversation_id = c.id
    AND a.submitted_at IS NULL ORDER BY a.id DESC LIMIT 1) AS draft_answer,
  (SELECT a.updated_at FROM attempt a WHERE a.conversation_id = c.id
    AND a.submitted_at IS NULL ORDER BY a.id DESC LIMIT 1) AS draft_updated_at,
  (SELECT title FROM material WHERE id = c.material_id) AS material_title,
  (SELECT source_file_name FROM material WHERE id = c.material_id)
    AS source_file_name,
  EXISTS (SELECT 1 FROM attempt a WHERE a.conversation_id = c.id)
    AS has_attempts,
  EXISTS (SELECT 1 FROM attempt a WHERE a.conversation_id = c.id
    AND a.submitted_at IS NULL) AS has_draft
FROM conversation c
WHERE (:goalId IS NULL OR c.goal_id = :goalId)
  AND (:unassignedOnly = 0 OR c.goal_id IS NULL)
  AND (
    :answerStatus IS NULL
    OR (:answerStatus = 'open'
      AND EXISTS (SELECT 1 FROM attempt a WHERE a.conversation_id = c.id)
      AND NOT EXISTS (SELECT 1 FROM attempt a
        WHERE a.conversation_id = c.id AND a.submitted_at IS NOT NULL))
    OR (:answerStatus = 'correct'
      AND EXISTS (SELECT 1 FROM attempt a WHERE a.conversation_id = c.id
        AND a.id = (SELECT a2.id FROM attempt a2
          WHERE a2.conversation_id = c.id AND a2.submitted_at IS NOT NULL
          ORDER BY a2.submitted_at DESC, a2.id DESC LIMIT 1)
        AND a.is_correct = 1))
    OR (:answerStatus = 'wrong'
      AND EXISTS (SELECT 1 FROM attempt a WHERE a.conversation_id = c.id
        AND a.id = (SELECT a2.id FROM attempt a2
          WHERE a2.conversation_id = c.id AND a2.submitted_at IS NOT NULL
          ORDER BY a2.submitted_at DESC, a2.id DESC LIMIT 1)
        AND a.is_correct = 0))
    OR (:answerStatus = 'unjudged'
      AND EXISTS (SELECT 1 FROM attempt a WHERE a.conversation_id = c.id
        AND a.id = (SELECT a2.id FROM attempt a2
          WHERE a2.conversation_id = c.id AND a2.submitted_at IS NOT NULL
          ORDER BY a2.submitted_at DESC, a2.id DESC LIMIT 1)
        AND a.is_correct IS NULL))
  )
ORDER BY c.updated_at DESC, c.id DESC
LIMIT COALESCE(:rowLimit, -1) OFFSET :rowOffset;

-- “继续上次”的候选：按最近一次学习行为取前若干条。
--
-- 草稿的保存时间也算一次学习行为，写草稿不改 `conversation.updated_at`，只看
-- 后者会把刚写下的草稿排到后面。两类时间各自取前若干名再取并集，任何一条进入
-- 全局前几名时，它至少在某一类的前几名里，因此结果与读全库再排序相同。
recentlyActiveRecords(REQUIRED :limit AS INT OR NULL):
WITH candidates AS (
  SELECT id FROM (
    SELECT c.id AS id FROM conversation c
    ORDER BY c.updated_at DESC, c.id DESC LIMIT COALESCE(:limit, -1)
  )
  UNION
  SELECT conversation_id FROM (
    SELECT a.conversation_id AS conversation_id FROM attempt a
    WHERE a.submitted_at IS NULL
    ORDER BY a.updated_at DESC, a.id DESC LIMIT COALESCE(:limit, -1)
  )
)
SELECT c.*,
  (SELECT COUNT(*) FROM message m WHERE m.conversation_id = c.id)
    AS message_count,
  (SELECT m.content FROM message m WHERE m.conversation_id = c.id
    ORDER BY m.id DESC LIMIT 1) AS preview,
  (SELECT m.content FROM message m WHERE m.conversation_id = c.id
    AND m.role = 'user' ORDER BY m.id DESC LIMIT 1) AS last_user_message,
  (SELECT a.user_answer FROM attempt a WHERE a.conversation_id = c.id
    AND a.submitted_at IS NULL ORDER BY a.id DESC LIMIT 1) AS draft_answer,
  (SELECT a.updated_at FROM attempt a WHERE a.conversation_id = c.id
    AND a.submitted_at IS NULL ORDER BY a.id DESC LIMIT 1) AS draft_updated_at,
  (SELECT title FROM material WHERE id = c.material_id) AS material_title,
  (SELECT source_file_name FROM material WHERE id = c.material_id)
    AS source_file_name,
  EXISTS (SELECT 1 FROM attempt a WHERE a.conversation_id = c.id)
    AS has_attempts,
  EXISTS (SELECT 1 FROM attempt a WHERE a.conversation_id = c.id
    AND a.submitted_at IS NULL) AS has_draft
FROM conversation c
JOIN candidates ON candidates.id = c.id
ORDER BY max(c.updated_at,
  coalesce((SELECT a.updated_at FROM attempt a
    WHERE a.conversation_id = c.id AND a.submitted_at IS NULL
    ORDER BY a.id DESC LIMIT 1), c.updated_at)) DESC,
  c.id DESC
LIMIT COALESCE(:limit, -1);

insertConversationRecord:
INSERT INTO conversation (title, goal_id, material_id, page_no, source_ref, context_text, entry_kind, status, created_at, updated_at)
VALUES (:title, :goalId, :materialId, :pageNo, :sourceRef, :contextText, :entryKind, 'open', :stamp, :stamp);

recordLastMessageTime:
UPDATE conversation SET updated_at = :stamp,
  last_message_at = :stamp
WHERE id = :conversationId;

setConversationGoal:
UPDATE conversation SET goal_id = :goalId,
  updated_at = :stamp
WHERE id = :conversationId;

setConversationMaterial:
UPDATE conversation SET material_id = :materialId,
  page_no = :pageNo,
  updated_at = :stamp
WHERE id = :conversationId;

setQuestionMessage:
UPDATE conversation SET question_message_id = :messageId
WHERE id = :conversationId;

endConversation:
UPDATE conversation SET status = 'ended',
  ended_at = :stamp,
  updated_at = :stamp
WHERE id = :conversationId;

deleteConversationRecord:
DELETE FROM conversation WHERE id = :conversationId;

reopenConversation:
UPDATE conversation SET status = 'open',
  ended_at = NULL,
  updated_at = :stamp
WHERE id = :conversationId;

conversationScope:
SELECT id, goal_id, material_id FROM conversation WHERE id = :id LIMIT 1;

-- 检索核对：一条题目命中的题干与出处。
--
-- 题干取开始作答时确定的用户消息；出处缺省时按材料标题与页码补一条，与题目的
-- 展示口径一致。这里保留原查询的 SQL 兜底，不换成 `materialPosition`，docx 材料
-- 的旧命中仍按“第 N 页”核对。
evidenceQuestionCurrent:
SELECT
  COALESCE(c.question_message_id, (
    SELECT m.id FROM message m
    WHERE m.conversation_id = c.id AND m.role = 'user'
    ORDER BY m.id LIMIT 1
  )) AS question_message_id,
  COALESCE(c.source_ref, (
    CASE WHEN (SELECT title FROM material WHERE id = c.material_id) IS NOT NULL
      AND c.page_no IS NOT NULL
    THEN '《' || (SELECT title FROM material WHERE id = c.material_id)
      || '》第 ' || c.page_no || ' 页' END
  )) AS source_ref,
  c.title, c.context_text, c.page_no, c.created_at, c.updated_at,
  (SELECT m.content FROM message m
    WHERE m.conversation_id = c.id AND m.role = 'user'
      AND m.id = COALESCE(c.question_message_id, (
        SELECT m2.id FROM message m2
        WHERE m2.conversation_id = c.id AND m2.role = 'user'
        ORDER BY m2.id LIMIT 1
      )) LIMIT 1) AS stem
FROM conversation c
WHERE c.id = :conversationId
LIMIT 1;
