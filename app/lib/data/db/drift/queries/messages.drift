-- 讨论消息的读写查询：一张表一个文件。

import '../tables.dart';

-- 最近的若干条消息，按编号倒序；`rowLimit` 传空表示不截断。
recentMessages(REQUIRED :conversationId AS TEXT, REQUIRED :rowLimit AS INT OR NULL):
SELECT * FROM message
WHERE conversation_id = :conversationId
ORDER BY id DESC
LIMIT COALESCE(:rowLimit, -1);

-- 讨论历史的一页：编号小于游标，按编号倒序多取一条判断是否还有更早的；
-- `beforeId` 传空表示从最新一条开始。
messagesPage(
  REQUIRED :conversationId AS TEXT,
  REQUIRED :beforeId AS TEXT OR NULL,
  REQUIRED :rowLimit AS INT
):
SELECT * FROM message
WHERE conversation_id = :conversationId
  AND (:beforeId IS NULL OR id < :beforeId)
ORDER BY id DESC
LIMIT :rowLimit;

-- 第一条或最后一条用户消息（带正文或图片）；`beforeId` 传空表示不限。
firstUserMessage(
  REQUIRED :conversationId AS TEXT,
  REQUIRED :beforeId AS TEXT OR NULL
):
SELECT * FROM message
WHERE conversation_id = :conversationId
  AND role = 'user'
  AND (TRIM(content) <> '' OR image_paths_json IS NOT NULL)
  AND (:beforeId IS NULL OR id < :beforeId)
ORDER BY id
LIMIT 1;

lastUserMessage:
SELECT * FROM message
WHERE conversation_id = :conversationId
  AND role = 'user'
  AND (TRIM(content) <> '' OR image_paths_json IS NOT NULL)
ORDER BY id DESC
LIMIT 1;

-- 按编号取一条消息。
messageById:
SELECT * FROM message WHERE id = :id LIMIT 1;

-- 这条记录的消息里带过的图片路径，清空记录时一并删除附件。
imagePathsOfConversation:
SELECT image_paths_json FROM message
WHERE conversation_id = :conversationId AND image_paths_json IS NOT NULL;

insertConversationMessage:
INSERT INTO message (id, conversation_id, role, content, image_paths_json, structured_json, created_at)
VALUES (:id, :conversationId, :role, :content, :imagePaths, :structuredJson, :stamp);

deleteConversationMessages:
DELETE FROM message WHERE conversation_id = :conversationId;

setMessageStructuredState:
UPDATE message SET structured_json = :structuredJson
WHERE id = :messageId;

-- 检索核对：一条消息命中的当前内容与所属讨论。
evidenceMessageCurrent:
SELECT m.content, m.created_at, c.id AS conversation_id, c.title,
  c.goal_id, c.material_id
FROM message m
JOIN conversation c ON c.id = m.conversation_id
WHERE m.id = :messageId
LIMIT 1;

-- 语义索引可用的全部讨论消息：按编号倒序，后台分批重建索引。
evidenceMessageSources:
SELECT m.id, m.conversation_id, m.content, m.created_at, c.material_id
FROM message m
JOIN conversation c ON c.id = m.conversation_id
WHERE m.role IN ('user', 'assistant') AND m.content != ''
ORDER BY m.id DESC;

-- 一条消息的当前内容与创建时间；嵌入很慢，写回索引前要重新读一次。
evidenceMessageSource:
SELECT content, created_at
FROM message
WHERE id = :messageId
LIMIT 1;
