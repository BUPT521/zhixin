-- 预约与时间安排的读写查询：一张表一个文件。

import '../tables.dart';

-- 与给定区间重叠的预约，按开始时间排序。
blocksOverlapping:
SELECT b.*, p.title AS p_title, p.note AS p_note, p.status AS p_status
FROM schedule_block b
JOIN plan_item p ON p.id = b.plan_item_id
WHERE b.start_at < :endAt AND b.end_at > :startAt
ORDER BY b.start_at;

-- 安排查找的预约：条件与事项同一套，日期改按预约开始时间落在自然日区间内。
--
-- 关键词由应用层按事项标题与说明筛，这里只筛目标、状态与日期（docs/02
-- 第 3.14 节）。
--
-- 四个参数都显式声明为必填文本：空字符串表示未筛选，与事项搜索同一套口径。
-- :goalId 同时与 '' 和可空的 goal_id 列比较，靠推断会在可空与非空之间摇摆，
-- 生成文件因此每次重建都可能不同，CI 的生成核对随之偶发失败。
searchPlanBlocks(
  REQUIRED :goalId AS TEXT,
  REQUIRED :status AS TEXT,
  REQUIRED :dayStart AS TEXT,
  REQUIRED :dayEnd AS TEXT
):
SELECT b.*, p.title AS p_title, p.note AS p_note, p.status AS p_status
FROM schedule_block b
JOIN plan_item p ON p.id = b.plan_item_id
WHERE (:goalId = '' OR p.goal_id = :goalId)
  AND (:status = '' OR p.status = :status)
  AND (:dayStart = '' OR (b.start_at >= :dayStart AND b.start_at < :dayEnd))
ORDER BY b.start_at DESC, b.id DESC;

-- 最近一条还没开始的待开始预约。
nextPlannedBlock:
SELECT b.*, p.title AS p_title, p.note AS p_note, p.status AS p_status
FROM schedule_block b
JOIN plan_item p ON p.id = b.plan_item_id
WHERE b.status = 'planned' AND b.start_at >= :now
ORDER BY b.start_at
LIMIT 1;

-- 全部待开始预约的时间，整组顺延时用来核对重叠。
plannedBlockSpans:
SELECT b.id, b.start_at, b.end_at, p.title
FROM schedule_block b
JOIN plan_item p ON p.id = b.plan_item_id
WHERE b.status = 'planned'
ORDER BY b.start_at;

-- 某个目标下可以自动调整的预约：待开始、未固定、且还没到开始时间。
adjustableBlocksForGoal:
SELECT b.*
FROM schedule_block b
JOIN plan_item p ON p.id = b.plan_item_id
WHERE p.goal_id = :goalId AND b.status = 'planned' AND b.locked = 0
  AND b.start_at >= :now
ORDER BY b.start_at;

-- 按编号批量取时间安排；调用方核对数量判断是否有人先删了。
blocksByIds:
SELECT * FROM schedule_block
WHERE id IN (SELECT value FROM json_each(:ids));

-- 某个事项之后尚未开始的预约，按开始时间。
upcomingBlocksForItem:
SELECT * FROM schedule_block
WHERE plan_item_id = :planItemId AND status = 'planned' AND start_at >= :now
ORDER BY start_at;

-- 每个事项最近一次尚未结束的预约；正在进行的也在这里。
firstLiveBlockPerItem:
SELECT * FROM schedule_block
WHERE plan_item_id IN (SELECT value FROM json_each(:planItemIds))
  AND status = 'planned' AND end_at > :now
ORDER BY start_at, id;

-- 每个事项之后尚未开始的预约，按事项分组用。
upcomingBlocksForItems:
SELECT * FROM schedule_block
WHERE plan_item_id IN (SELECT value FROM json_each(:planItemIds))
  AND status = 'planned' AND start_at >= :now
ORDER BY start_at;

-- 按编号取一条时间安排。
scheduleBlockById:
SELECT * FROM schedule_block WHERE id = :id LIMIT 1;

-- 某个事项的全部预约，按开始时间。
blocksForItem:
SELECT * FROM schedule_block
WHERE plan_item_id = :planItemId
ORDER BY start_at;

cancelPlannedBlocksForItem:
UPDATE schedule_block SET status = 'cancelled',
  updated_at = :stamp
WHERE plan_item_id = :itemId AND status = 'planned';

insertScheduleBlock:
INSERT INTO schedule_block (id, plan_item_id, start_at, end_at, source, status, locked, created_at, updated_at)
VALUES (:id, :itemId, :startAt, :endAt, :source, 'planned', :locked, :stamp, :stamp);

updatePlannedBlockTime:
UPDATE schedule_block SET start_at = :startAt,
  end_at = :endAt,
  status = 'planned',
  updated_at = :stamp
WHERE id = :blockId;

setBlockLocked:
UPDATE schedule_block SET locked = :locked,
  updated_at = :stamp
WHERE id = :blockId;

cancelPlannedBlocks:
UPDATE schedule_block SET status = 'cancelled',
  updated_at = :stamp
WHERE id IN (SELECT value FROM json_each(:ids)) AND status = 'planned';

setScheduleBlockStatus:
UPDATE schedule_block SET status = :status,
  updated_at = :stamp
WHERE id = :blockId;

deleteScheduleBlock:
DELETE FROM schedule_block WHERE id = :blockId;

-- 待开始的预约里，与给定区间重叠的那些；忽略的预约用 JSON 数组传入，
-- 避免在 SQL 里拼可变个数的占位符。
findOverlappingBlocks:
SELECT b.start_at, b.end_at, p.title
FROM schedule_block b
JOIN plan_item p ON p.id = b.plan_item_id
WHERE b.status = 'planned' AND b.start_at < :endAt AND b.end_at > :startAt
  AND b.id NOT IN (SELECT value FROM json_each(:ignoredBlockIds))
ORDER BY b.start_at
LIMIT 1;

-- 还没结束的待开始预约，按开始时间排序；新增课时反过来查它们。
plannedBlocksAfter:
SELECT b.start_at, b.end_at, p.title
FROM schedule_block b
JOIN plan_item p ON p.id = b.plan_item_id
WHERE b.status = 'planned' AND b.end_at > :after
ORDER BY b.start_at;

