-- 材料页的读写查询：一张表一个文件。

import '../tables.dart';

-- 一份材料的全部页码，按页序。
pagesOfMaterial:
SELECT * FROM material_page
WHERE material_id = :materialId
ORDER BY page_no;

-- 材料里选中的一段页；起止传 0 表示这一端不限。
pagesInRange:
SELECT * FROM material_page
WHERE material_id = :materialId
  AND (:pageFrom = 0 OR page_no >= :pageFrom)
  AND (:pageTo = 0 OR page_no <= :pageTo)
ORDER BY page_no;

-- 按编号取一页。
pageById:
SELECT * FROM material_page WHERE id = :pageId LIMIT 1;

-- 这一页属于哪份材料；删除后仍按它更新材料的修改时间。
pageMaterialId:
SELECT material_id FROM material_page WHERE id = :pageId LIMIT 1;

insertMaterialPage:
INSERT INTO material_page (material_id, page_no, label, content, created_at, updated_at)
VALUES (:materialId, :pageNo, :label, :content, :stamp, :stamp);

updateMaterialPage:
UPDATE material_page SET content = :content,
  label = :label,
  updated_at = :stamp
WHERE id = :pageId;

deleteMaterialPage:
DELETE FROM material_page WHERE id = :pageId;

-- 一份材料的页码范围；没有页时两列都是空。
materialPageBounds:
SELECT MIN(page_no) AS first_page, MAX(page_no) AS last_page
FROM material_page
WHERE material_id = :materialId;

-- 一份材料的一页。
materialPageByNumber:
SELECT * FROM material_page
WHERE material_id = :materialId AND page_no = :pageNo
LIMIT 1;

-- 检索核对：一条材料页命中的当前内容与材料标题，用来判断内容是否换过版本。
evidenceMaterialPageCurrent:
SELECT mp.content, mp.label, mp.updated_at, m.title, m.source_file_name
FROM material_page mp
JOIN material m ON m.id = mp.material_id
WHERE mp.material_id = :materialId AND mp.page_no = :pageNo
LIMIT 1;

-- 语义索引可用的全部材料页：按最近更新倒序，后台分批重建索引。
evidenceMaterialPageSources:
SELECT mp.material_id, mp.page_no, mp.content, mp.updated_at
FROM material_page mp
ORDER BY mp.updated_at DESC, mp.material_id, mp.page_no;

-- 一条材料页的当前内容与更新时间；嵌入很慢，写回索引前要重新读一次。
evidenceMaterialPageSource:
SELECT content, updated_at
FROM material_page
WHERE material_id = :materialId AND page_no = :pageNo
LIMIT 1;
