-- 学习目标的读写查询：一张表一个文件。

import '../tables.dart';

-- 当前有效的目标；没有截止日期的排在后面。
activeGoals:
SELECT * FROM learning_goal
WHERE status = :status
ORDER BY due_date IS NULL, due_date, id DESC;

-- 按编号取目标。
goalById:
SELECT * FROM learning_goal WHERE id = :id LIMIT 1;

insertLearningGoal:
INSERT INTO learning_goal (title, scope_text, due_date, status, created_at, updated_at)
VALUES (:title, :scopeText, :dueDate, :status, :stamp, :stamp);

setLearningGoalStatus:
UPDATE learning_goal SET status = :status,
  updated_at = :stamp
WHERE id = :goalId;

-- 全部目标，当前有效的排在最前，其余按新建时间倒序。
goals:
SELECT * FROM learning_goal
ORDER BY CASE status WHEN :activeStatus THEN 0 WHEN :pausedStatus THEN 1
  WHEN :doneStatus THEN 2 ELSE 3 END, id DESC;
